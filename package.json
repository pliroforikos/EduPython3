{
  "name": "edupython3",
  "productName": "EduPython3",
  "version": "1.0.0",
  "description": "Φιλικό περιβάλλον προγραμματισμού Python 3 για μαθητές (τύπου Thonny)",
  "main": "src/main/main.js",
  "desktopName": "edupython3.desktop",
  "author": "Λέων Προκόπης, καθηγητής Πληροφορικής ΠΕ86",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\" && C:/Python27/python.exe -m unittest discover -s tests -p \"test_*.py\"",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:linux": "node scripts/build-linux.js"
  },
  "build": {
    "appId": "gr.edu.python3",
    "productName": "EduPython3",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "backend/**/*.py",
      "examples/**/*.py",
      "package.json",
      "node_modules/monaco-editor/min/**/*"
    ],
    "asarUnpack": [
      "backend/**/*",
      "examples/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "py",
        "name": "Πρόγραμμα Python",
        "role": "Editor",
        "mimeType": "text/x-python"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "EduPython3-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "EduPython3-${version}-setup.exe",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "EduPython3"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "edupython3",
      "maintainer": "Λέων Προκόπης <37191269+pliroforikos@users.noreply.github.com>",
      "synopsis": "Περιβάλλον προγραμματισμού Python 3 για μαθητές",
      "description": "Φιλικό περιβάλλον προγραμματισμού Python 3 τύπου Thonny για μαθητές Γυμνασίου, Λυκείου, ΕΠΑΛ και αυτοδίδακτους.",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "edupython3_${version}_amd64.deb"
    }
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pliroforikos/EduPython3.git"
  },
  "homepage": "https://github.com/pliroforikos/EduPython3"
}
